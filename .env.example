# Database Configuration
DATABASE_URL=sqlite:///./tenant_system.db
# For PostgreSQL: postgresql://user:password@localhost/dbname

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Google Gemini API
GOOGLE_API_KEY=your_google_api_key_here

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# OCR Configuration
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MIN_CONFIDENCE=0.3
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe  # Windows only, if not in PATH

# Feature Flags
ENABLE_PUBLIC_CHAT=true
ENABLE_PUBLIC_AGENT=true
ENABLE_LLM_TRACKING=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Cleanup Service
CLEANUP_INTERVAL_HOURS=24
CLEANUP_RETENTION_DAYS=30

# STT (Speech-to-Text) Configuration
STT_PROVIDER=whisper_tiny  # Options: whisper_tiny, whisper_base, whisper_large, assemblyai, azure, google
WHISPER_MODEL=tiny  # For Whisper: tiny, base, small, medium, large

# AssemblyAI Configuration (if using assemblyai provider)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Azure Speech Configuration (if using azure provider)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Google Speech Configuration (if using google provider)
GOOGLE_CREDENTIALS_PATH=path/to/google-credentials.json
